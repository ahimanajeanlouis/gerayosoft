# Leave DATABASE_URL empty to use local SQLite automatically.
# MySQL/MariaDB example:
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST/DATABASE
DATABASE_URL=

SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Email verification and password reset are handled locally in the app.
# No SMTP/Resend service is required.

# Admin login for /admin. Change these before deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
